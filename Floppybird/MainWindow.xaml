<Window x:Class="Floppybird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Floppybird"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Space">

    <Grid>
        <Canvas KeyDown="Space" Background="skyBlue">
            <Image x:Name="img_floppybird" Source="pack://application:,,,/floppybird.png" Height="25" Canvas.Left="21" Canvas.Top="205" Width="33" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.ZIndex="10" />
            <Rectangle x:Name="r_top" Width="55" Height="180" Fill="#FF224021" Canvas.Left="716" Canvas.Top="-14" HorizontalAlignment="Center" VerticalAlignment="Top" />
            <Rectangle x:Name="r_bottom" Width="55" Height="180" Fill="#FF224021" Canvas.Left="716" Canvas.Top="254" HorizontalAlignment="Center" VerticalAlignment="Center" />



        </Canvas>

    </Grid>
</Window>
