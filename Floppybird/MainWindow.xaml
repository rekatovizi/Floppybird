<Window x:Class="Floppybird.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Floppybird"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        KeyDown="Space">

    <Grid>
        <Canvas KeyDown="Space" Background="skyBlue">
            <Image x:Name="img_floppybird" Source="pack://application:,,,/floppybird.png" Height="25" Canvas.Left="21" Canvas.Top="205" Width="33" HorizontalAlignment="Left" VerticalAlignment="Top"  />
            <TextBlock Canvas.Left="640" TextWrapping="Wrap" Height="434" Width="54" Background="ForestGreen"/>
            <TextBlock Canvas.Left="639" TextWrapping="Wrap" Canvas.Top="205" HorizontalAlignment="Center" VerticalAlignment="Top" Width="56" Height="88" Background="SkyBlue"/>


        </Canvas>

    </Grid>
</Window>
